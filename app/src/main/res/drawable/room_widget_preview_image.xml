<?xml version="1.0" encoding="utf-8"?>
<!--
  Fallback preview for the widget picker on API < 31, where android:previewLayout is ignored and
  only android:previewImage is honoured. On API 31+ the launcher prefers room_widget_preview.xml,
  which is a much better likeness.

  This is a hand-drawn stand-in: a header bar with an avatar, then two message rows. To replace it
  with a real screenshot, drop a PNG at res/drawable-nodpi/room_widget_preview_image.png and delete
  this file — the resource name is what room_widget_info.xml references, not the format.
-->
