<?xml version="1.0" encoding="utf-8"?>
<!-- accountType is a per-flavour resValue (see productFlavors in app/build.gradle.kts): two flavours
     sharing one account type means only the one that installed first can ever create it, and every
     other flavour gets a SecurityException from addAccountExplicitly. -->
<account-authenticator
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:accountType="@string/account_type"
    android:label="@string/app_name"
    android:icon="@mipmap/ic_launcher" />
