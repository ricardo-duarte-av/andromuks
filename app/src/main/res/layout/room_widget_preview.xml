<?xml version="1.0" encoding="utf-8"?>
<!--
  Static preview shown in the launcher's widget picker (android:previewLayout, API 31+).

  This is NOT the widget: it is a plain RemoteViews-compatible mock of what the widget looks like
  once configured. It has to be static because the picker renders it without ever starting a Glance
  session — which is why pointing previewLayout at Glance's loading layout, as this did originally,
  produced a spinner that never resolved.

  Theme attributes rather than fixed colours so it follows the launcher's light/dark treatment.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="?android:attr/colorBackground">

    <!-- Header: room avatar + room name -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_matrix_notification"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:text="@string/room_widget_preview_room" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_widget_refresh"
            android:contentDescription="@null" />
    </LinearLayout>

    <!-- Two sample message rows -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <View
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/room_widget_preview_avatar" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textSize="12sp"
                android:textColor="?android:attr/colorAccent"
                android:text="@string/room_widget_preview_sender_one" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:ellipsize="end"
                android:textSize="14sp"
                android:textColor="?android:attr/textColorPrimary"
                android:text="@string/room_widget_preview_message_one" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <View
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/room_widget_preview_avatar" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textSize="12sp"
                android:textColor="?android:attr/colorAccent"
                android:text="@string/room_widget_preview_sender_two" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:ellipsize="end"
                android:textSize="14sp"
                android:textColor="?android:attr/textColorPrimary"
                android:text="@string/room_widget_preview_message_two" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
