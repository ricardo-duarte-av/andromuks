# Formatting rules for the whole repo. detekt's ktlint-wrapper ruleset reads this file, so it is the
# single source of truth for Kotlin formatting (indentation, imports, line length, code style).
# https://pinterest.github.io/ktlint/latest/rules/configuration/
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
# `intellij_idea` matches Android Studio's default formatter; switch to `android_studio` only if the
# team standardises on the stricter AOSP style.
ktlint_code_style = intellij_idea
max_line_length = 120
# Compose @Composable functions are PascalCase; exempt them from the function-naming rule so the
# ktlint-wrapper doesn't fight compose-rules' ComposableNaming.
ktlint_function_naming_ignore_when_annotated_with = Composable
# Wildcard imports are disallowed by default (no `import foo.*`); keep that on.

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
